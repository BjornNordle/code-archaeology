# Caddyfile for code-archaeology
#
# Serves plain HTTP on :80 (mapped to :8081 on the host) for any host/IP.
# auto_https is disabled globally — bare IPs cannot get a trusted cert.
#
# To enable HTTPS later: remove the global block, change `:80` to `{$DOMAIN}`
# (set DOMAIN to a real domain), and uncomment 443 ports in docker-compose.yml.

{
    auto_https off
}

:80 {
    reverse_proxy app:8000
    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format console
    }
}
